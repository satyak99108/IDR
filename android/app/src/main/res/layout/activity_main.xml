<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- OSMDroid Fullscreen OpenStreetMap View -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- TOP: Telemetry Heads-Up Dashboard -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTelemetry"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="#E61E293B"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/surface_card_border"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Title & Status Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/title_telemetry"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <!-- Source Badge (Live vs Replay) -->
                <TextView
                    android:id="@+id/tvSourceBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IO-VNBD REPLAY"
                    android:textColor="#38BDF8"
                    android:background="#1A0284C7"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Main Telemetry Row: Speedometer + Status Badges -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <!-- Large Digital Speedometer -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom">

                    <TextView
                        android:id="@+id/tvSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/default_speed"
                        android:textColor="@color/text_primary"
                        android:textSize="36sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" km/h"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="32dp"
                    android:background="@color/surface_card_border"
                    android:layout_marginHorizontal="16dp" />

                <!-- Mode & GNSS Badges -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Mode Badge -->
                    <TextView
                        android:id="@+id/tvNavMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GNSS + INS"
                        android:textColor="@color/status_gnss"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <!-- GNSS Status -->
                    <TextView
                        android:id="@+id/tvGnssStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gnss_active"
                        android:textColor="#34D399"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Secondary Metrics: Confidence & Outage Timer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvConfidence"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Confidence: 95%"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvOutageTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tunnel Outage: 0.0s"
                    android:textColor="@color/status_outage"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Recenter Map Floating Action Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabRecenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:backgroundTint="@color/surface_card"
        app:tint="@color/fab_active_tint"
        app:srcCompat="@android:drawable/ic_menu_mylocation"
        android:contentDescription="@string/recenter_map"
        app:fabSize="mini"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/cardJudgeControls" />

    <!-- BOTTOM: Judge Demonstration Control Deck -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardJudgeControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="#F20F172A"
        app:cardCornerRadius="16dp"
        app:cardElevation="10dp"
        app:strokeColor="@color/surface_card_border"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Primary Interactive Button: Toggle Tunnel Outage -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleOutage"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="@string/btn_kill_gnss"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="13sp"
                app:backgroundTint="@color/btn_tunnel_bg"
                app:cornerRadius="12dp"
                app:icon="@android:drawable/ic_dialog_alert"
                app:iconGravity="textStart" />

            <!-- Secondary Controls Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:weightSum="2">

                <!-- Mode Switch: Live vs Replay -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleSource"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1.3"
                    android:layout_marginEnd="4dp"
                    android:text="@string/btn_mode_live"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    app:strokeColor="@color/surface_card_border"
                    app:cornerRadius="10dp" />

                <!-- Reset Trajectory -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReset"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="0.7"
                    android:layout_marginStart="4dp"
                    android:text="@string/btn_reset"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    app:strokeColor="@color/surface_card_border"
                    app:cornerRadius="10dp" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
